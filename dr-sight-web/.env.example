# Copy to `.env` and fill in.
#
# DR-Sight FastAPI service base URL (no trailing slash).
#  - dev  : the app calls `/model/*`, which Vite proxies to this target.
#  - prod : the built app calls this URL directly, so the service must
#           allow-list this app's origin (ALLOWED_ORIGIN on the DR-Sight API).
# Current temporary dev tunnel (changes every restart — ask Giridharan):
VITE_MODEL_API_URL=https://cabinet-born-newcastle-tribes.trycloudflare.com

# Must match API_KEY on the DR-Sight service. Sent as the X-API-Key header.
# NOTE: with a direct browser -> FastAPI connection this ends up in the client
# bundle. Fine for local/demo; use a proxy for a public deployment.
VITE_MODEL_API_KEY=175615c9ea8da92ca43392be107463536387bd2f3ca12de2
